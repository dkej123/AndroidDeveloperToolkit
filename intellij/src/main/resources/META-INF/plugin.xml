<idea-plugin>
    <id>dev.acme.adbtoolbox</id>
    <name>ADB Toolbox</name>
    <vendor>ADB Toolbox</vendor>

    <description><![CDATA[
        Device, app, display, network, and logcat controls for Android Studio / IntelliJ IDEA,
        without leaving the IDE. UI, tool window, and feature actions land in later tasks.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="adb-toolbox-android.xml">org.jetbrains.android</depends>
    <depends optional="true" config-file="adb-toolbox-terminal.xml">org.jetbrains.plugins.terminal</depends>

    <!-- Project services are registered as light @Service classes (AdbToolboxProjectService),
         which need no XML entry here. -->
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="ADB Toolbox" anchor="right" secondary="false"
                    icon="/icons/adbToolbox.svg"
                    factoryClass="dev.acme.adbtoolbox.intellij.toolwindow.AdbToolboxToolWindowFactory"/>
        <projectConfigurable parentId="tools"
                             instance="dev.acme.adbtoolbox.intellij.settings.AdbToolboxSettingsConfigurable"
                             id="dev.acme.adbtoolbox.settings"
                             displayName="ADB Toolbox"/>
    </extensions>

    <!-- Task 018's global mirroring shortcut — forwards to the same MirroringViewModel.handle
         entry point the Device-view toggle button uses; design/README.md suggests shift+cmd+M. Two
         keymap entries give the suggested Mac chord and a Ctrl-based equivalent everywhere else,
         since IntelliJ's "meta" modifier only exists as a real key on macOS keymaps. -->
    <actions>
        <action id="dev.acme.adbtoolbox.ToggleMirroring"
                class="dev.acme.adbtoolbox.intellij.mirroring.MirroringToggleAction"
                text="Toggle Device Mirroring"
                description="Start or stop mirroring the selected device">
            <keyboard-shortcut keymap="$default" first-keystroke="shift control M"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="shift meta M"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="shift meta M"/>
        </action>

        <!-- Task 023's global restart shortcut — forwards to the same AppLifecycleViewModel.handle
             entry point the Apps-view Restart button uses; design/README.md's Restart tooltip and
             design/IMPLEMENTATION.md's example plugin.xml both name shift+cmd+R / this action id. -->
        <action id="AdbToolbox.RestartApp"
                class="dev.acme.adbtoolbox.intellij.apps.RestartAppAction"
                text="Restart App"
                description="Force-stop, then launch the selected app's main activity">
            <keyboard-shortcut keymap="$default" first-keystroke="shift control R"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="shift meta R"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="shift meta R"/>
        </action>

        <!-- Task 037's global focus-Logcat shortcut — forwards to the same NavigationViewModel.handle
             entry point the rail uses; design/README.md's Interactions section names shift+cmd+L. -->
        <action id="AdbToolbox.FocusLogcat"
                class="dev.acme.adbtoolbox.intellij.logcat.FocusLogcatAction"
                text="Focus Logcat"
                description="Switch to the Logcat view">
            <keyboard-shortcut keymap="$default" first-keystroke="shift control L"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="shift meta L"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="shift meta L"/>
        </action>
    </actions>
</idea-plugin>
