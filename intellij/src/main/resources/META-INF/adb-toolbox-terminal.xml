<idea-plugin>
    <!-- Loaded only when org.jetbrains.plugins.terminal is loaded (task 016, ADR 0007). The marker
         tells the plugin so (InstalledPlugins.terminalLoaded); TerminalLauncherAdapter calls the
         Terminal plugin's API directly rather than contributing an extension point. -->
    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="io.github.dkej123.devicecockpit.intellij.host.TerminalPluginMarker"/>
    </extensions>
</idea-plugin>
